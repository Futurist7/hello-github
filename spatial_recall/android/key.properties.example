# Copy to android/key.properties (git-ignored) and fill in. Never commit the real file.
# Create a keystore with:
#   keytool -genkey -v -keystore ~/spatial-recall-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/spatial-recall-upload.jks
